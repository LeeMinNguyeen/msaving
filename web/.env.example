# Copy to .env.local (untracked). Public values only: everything here ends up in
# the browser bundle. Never put the service_role key or a database URL here.
#
# Default: the shared development environment's sign-in, and the API running
# on your machine (msaving-backend: uvicorn ... --port 8000).

# The API. Frontend-only work: use the development API instead and skip running
# the backend: VITE_API_URL=https://msaving-api-dev.leminhnguyen.com
VITE_API_URL=http://127.0.0.1:8000
# The development landing site (privacy policy at SITE_URL/privacy/<version>).
VITE_SITE_URL=https://msaving-dev.leminhnguyen.com
# The development Supabase project, for sign-in only. Public by design.
VITE_SUPABASE_URL=https://<dev project ref>.supabase.co   # msaving-docs, Run locally
VITE_SUPABASE_PUBLISHABLE_KEY=   # msaving-docs, Run locally

# ---- Schema work only (local Supabase in msaving-backend): use these two instead,
# with the key from `supabase status -o env | grep PUBLISHABLE_KEY`.
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Store pages of the mobile app, once it's published. Set = phones opening the
# web app are sent to the store. Leave empty until then.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
