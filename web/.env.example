# Optional. Copy to .env.local (untracked). Public values only: everything here
# ends up in the browser bundle.
#
# Nothing is needed for development: `npm run dev` sends /v1 to the API on this
# machine through Vite's proxy (MSAVING_API=http://127.0.0.1:8080 npm run dev
# for the compose stack instead).

# Store pages of the mobile app, once it's published. Set = phones opening the
# web app are offered it.
VITE_APP_STORE_URL=
VITE_PLAY_STORE_URL=
