# Copy to .env (untracked). Hosted environments set these in Cloud Run settings
# and Secret Manager instead.
#
# Default: your local API uses the shared development environment (Supabase
# database and sign-in). Only someone changing the schema runs Supabase locally:
# see "Schema work" at the bottom.

# The development Supabase project (public address).
SUPABASE_URL=https://<dev project ref>.supabase.co   # msaving-docs, Run locally
# The web app's origin (Vite dev server); CORS allows it.
APP_URL=http://localhost:5173
# The development landing site; the export links its privacy policy texts.
SITE_URL=https://msaving-dev.leminhnguyen.com

# SECRET. The development API login, through the Transaction pooler (port 6543).
# Ask the project owner for it; never commit it or paste it in chat.
DATABASE_URL=postgresql+psycopg://api_login.<dev project ref>:<password>@<pooler host>:6543/postgres?sslmode=require

# ---- Schema work only: local Supabase (`supabase start`) instead of the lines above.
# SUPABASE_URL=http://127.0.0.1:54321
# SITE_URL=http://localhost:4321
# DATABASE_URL=postgresql+psycopg://api_login:local-only-password@127.0.0.1:54322/postgres?sslmode=disable
