# Optional settings for docker-compose.yml. Copy to .env next to it and
# uncomment what you need. Without a .env, Waterflow runs at http://localhost:8080
# with its own database.

# The port, and who can reach it. 127.0.0.1 = only this machine (behind Caddy,
# Tailscale or a tunnel). 0.0.0.0 = every network this machine is on, over
# plain HTTP: only on a home network you trust.
# PORT=8080
# BIND=127.0.0.1

# HTTPS with your own domain, through the Caddy service (needed for the mobile app).
# COMPOSE_PROFILES=https
# DOMAIN=money.example.com

# One-click updates from the web app (Server admin). Turns on a helper that can
# control Docker on this machine, so it's off by default. Combine profiles with
# a comma: COMPOSE_PROFILES=https,updater
# COMPOSE_PROFILES=updater

# The admin page checks GitHub for a newer release. off = never.
# UPDATE_CHECK=on

# The project's website, where the admin page's "What's new" opens the changelog.
# PROJECT_SITE_URL=https://waterflow-app.net

# Your own database instead of the built-in one: any PostgreSQL 15 or newer,
# or a Supabase project (its Session pooler connection, user postgres.<project
# ref>; the direct connection needs IPv6). Then start with:
#   docker compose up -d --scale db=0
# ADMIN_DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres?sslmode=require

# Exchange rates come from a free source with no key. To use Open Exchange
# Rates instead, your own app id:
# OXR_APP_ID=

# When the daily jobs run (purge, backup, exchange rates), as an hour in UTC.
# 19 = 02:00 in Vietnam.
# JOBS_HOUR=19
